{
  "name": "vaal-street-desktop",
  "version": "2.0.0",
  "description": "Vaal Street as one Windows app: the desk, its hideout window and the screen check",
  "private": true,
  "license": "MIT",
  "author": "Vaal Street",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.roelschr.vaalstreet",
    "productName": "Vaal Street",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/vaal-desk",
        "to": "vaal-desk"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "VaalStreet-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
